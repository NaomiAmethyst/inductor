{
  "check": {
    "options": []
  },
  "ingest": {
    "options": [
      {
        "names": [
          "--author"
        ],
        "help": "limit to one creator id"
      },
      {
        "names": [
          "--limit"
        ],
        "type": "int",
        "default": 0
      },
      {
        "names": [
          "--needs"
        ],
        "action": "append",
        "default": [],
        "help": "only records whose item still lists this in needs: (description, summary, tags, spoilers). Repeatable"
      },
      {
        "names": [
          "--stage"
        ],
        "action": "append",
        "choices": [
          "media",
          "transcribe",
          "analyse",
          "review",
          "emit"
        ],
        "help": "run only this stage (repeatable)"
      },
      {
        "names": [
          "--new"
        ],
        "action": "store_true",
        "help": "only records nothing has an entry for at all"
      },
      {
        "names": [
          "--redo"
        ],
        "action": "store_true",
        "help": "include items that are already finished; without it a run does only what is outstanding"
      },
      {
        "names": [
          "--redo-analysis"
        ],
        "action": "store_true",
        "help": "analyse again even where a cached analysis exists"
      },
      {
        "names": [
          "--in-flight"
        ],
        "type": "int",
        "default": 4,
        "help": "review batches submitted at once"
      },
      {
        "names": [
          "--poll"
        ],
        "type": "int",
        "default": 60
      },
      {
        "names": [
          "--recover"
        ],
        "action": "append",
        "default": [],
        "help": "adopt an already-submitted review batch"
      },
      {
        "names": [
          "--overwrite"
        ],
        "action": "store_true",
        "help": "let this run replace a summary or spoilers that are already written; without it nothing existing is touched"
      },
      {
        "names": [
          "--no-covers"
        ],
        "action": "store_true",
        "help": "skip cover art even where the config asks for it"
      },
      {
        "names": [
          "--force"
        ],
        "action": "store_true",
        "help": "ingest even though the sources have errors"
      }
    ]
  },
  "adjudicate": {
    "options": [
      {
        "names": [
          "--collect"
        ],
        "action": "store_true",
        "help": "show what is pending"
      },
      {
        "names": [
          "--from-reviews"
        ],
        "action": "store_true",
        "help": "rule on what the reviewer asked to keep, from the stored enrichments rather than from items"
      },
      {
        "names": [
          "--apply"
        ],
        "action": "store_true",
        "help": "fold the rulings into the registry and onto the items"
      },
      {
        "names": [
          "--write"
        ],
        "action": "store_true",
        "help": "with --apply, actually write"
      },
      {
        "names": [
          "--rulings"
        ],
        "type": "pathlib.Path",
        "help": "where the rulings file lives"
      },
      {
        "names": [
          "--model"
        ],
        "help": "override the configured adjudicator"
      }
    ]
  },
  "authors": {
    "options": [
      {
        "names": [
          "--limit"
        ],
        "type": "int",
        "default": 0
      },
      {
        "names": [
          "--redo"
        ],
        "action": "store_true",
        "help": "include creators that have art"
      },
      {
        "names": [
          "--keep-synopsis"
        ],
        "action": "store_true",
        "help": "re-do the art only; leave the written paragraphs alone"
      },
      {
        "names": [
          "--no-render"
        ],
        "action": "store_true",
        "help": "write prompts, draw nothing"
      },
      {
        "names": [
          "--write"
        ],
        "action": "store_true",
        "help": "write the changes"
      },
      {
        "names": [
          "--model"
        ],
        "help": "override the configured cheap model"
      }
    ]
  },
  "voiceprint": {
    "options": [
      {
        "names": [
          "--embed"
        ],
        "action": "store_true",
        "help": "embed what is not done yet"
      },
