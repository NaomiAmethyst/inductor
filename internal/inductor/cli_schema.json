        "action": "store_true"
      },
      {
        "names": [
          "--batch"
        ],
        "type": "int",
        "default": 150
      },
      {
        "names": [
          "--remote-dir"
        ],
        "default": "inductor"
      },
      {
        "names": [
          "--force"
        ],
        "action": "store_true"
      },
      {
        "names": [
          "--dry-run"
        ],
        "action": "store_true"
      }
    ]
  },
